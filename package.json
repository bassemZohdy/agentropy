{
  "name": "agentropy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check \"packages/**/*.{ts,json}\" \"*.{json,mjs,ts}\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "example:price-watch": "tsc -b && node packages/examples/dist/price-watch.js",
    "example:expense-approval": "tsc -b && node packages/examples/dist/expense-approval.js",
    "example:quickstart": "tsc -b && node packages/examples/dist/quickstart.js",
    "docs:api": "node scripts/api-index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.34.9"
}
