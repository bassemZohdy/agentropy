{
  "name": "agentropy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check \"packages/**/*.{ts,json}\" \"*.{json,mjs,ts}\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && node scripts/api-index.mjs --check",
    "example:price-watch": "tsc -b && node packages/examples/dist/price-watch.js",
    "example:expense-approval": "tsc -b && node packages/examples/dist/expense-approval.js",
    "example:quickstart": "tsc -b && node packages/examples/dist/quickstart.js",
    "docs:api": "node scripts/api-index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "minimatch@^10.0.0": "^11.0.1"
    }
  }
}
