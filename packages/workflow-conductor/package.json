{
  "name": "@agentropy/workflow-conductor",
  "version": "0.0.0",
  "private": true,
  "description": "Agentropy WorkflowEngine adapter for Conductor.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassemZohdy/agentropy.git",
    "directory": "packages/workflow-conductor"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
