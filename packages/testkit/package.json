{
  "name": "@agentropy/testkit",
  "version": "0.1.0",
  "description": "Agentropy testkit: offline fakes and reusable conformance suites for provider authors.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassemZohdy/agentropy.git",
    "directory": "packages/testkit"
  },
  "homepage": "https://github.com/bassemZohdy/agentropy/tree/main/packages/testkit#readme",
  "bugs": {
    "url": "https://github.com/bassemZohdy/agentropy/issues"
  },
  "keywords": [
    "agents",
    "testing",
    "fakes",
    "conformance",
    "agentropy"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@agentropy/core": "workspace:*"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@electric-sql/pglite": "0.6.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
