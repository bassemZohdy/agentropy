{
  "name": "@agentropy/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "Agentropy testkit: offline fakes and reusable conformance suites for provider authors.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassemZohdy/agentropy.git",
    "directory": "packages/testkit"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@agentropy/core": "workspace:*"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@electric-sql/pglite": "0.5.10",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
