{
  "name": "@agentropy/store-postgres",
  "version": "0.1.0",
  "description": "Agentropy Store adapter for PostgreSQL on a driver-neutral client port.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassemZohdy/agentropy.git",
    "directory": "packages/store-postgres"
  },
  "homepage": "https://github.com/bassemZohdy/agentropy/tree/main/packages/store-postgres#readme",
  "bugs": {
    "url": "https://github.com/bassemZohdy/agentropy/issues"
  },
  "keywords": [
    "agents",
    "postgresql",
    "storage",
    "durable-execution",
    "agentropy"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@agentropy/core": "workspace:*"
  },
  "devDependencies": {
    "@agentropy/testkit": "workspace:*",
    "@electric-sql/pglite": "0.6.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
