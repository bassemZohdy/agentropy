{
  "name": "@agentropy/store-sqlite",
  "version": "0.1.0",
  "description": "Agentropy Store adapter on node:sqlite (single process).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassemZohdy/agentropy.git",
    "directory": "packages/store-sqlite"
  },
  "homepage": "https://github.com/bassemZohdy/agentropy/tree/main/packages/store-sqlite#readme",
  "bugs": {
    "url": "https://github.com/bassemZohdy/agentropy/issues"
  },
  "keywords": [
    "agents",
    "sqlite",
    "storage",
    "durable-execution",
    "agentropy"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@agentropy/core": "workspace:*"
  },
  "devDependencies": {
    "@agentropy/testkit": "workspace:*"
  }
}
