{
  "name": "@agentropy/runtime",
  "version": "0.1.0",
  "description": "Agentropy runtime: registries, task service, scheduler, communication providers (direct, A2A) and the local app facade.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassemZohdy/agentropy.git",
    "directory": "packages/runtime"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@agentropy/core": "workspace:*",
    "semver": "^7.8.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "@agentropy/testkit": "workspace:*",
    "@agentropy/store-sqlite": "workspace:*"
  }
}
