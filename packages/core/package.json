{
  "name": "@agentropy/core",
  "version": "0.0.0",
  "private": true,
  "description": "Agentropy contracts: types, JSON Schemas, the error catalog, lifecycle tables and pure resolvers (no I/O).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassemZohdy/agentropy.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  }
}
